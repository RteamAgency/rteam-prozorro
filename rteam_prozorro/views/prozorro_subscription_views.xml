<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prozorro_subscription_view_search" model="ir.ui.view">
        <field name="name">prozorro.subscription.search</field>
        <field name="model">prozorro.subscription</field>
        <field name="arch" type="xml">
            <search string="Prozorro Subscriptions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="classification_ids"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <filter name="creates_lead" string="Creates lead" domain="[('create_lead','=',True)]"/>
                <group>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="prozorro_subscription_view_list" model="ir.ui.view">
        <field name="name">prozorro.subscription.list</field>
        <field name="model">prozorro.subscription</field>
        <field name="arch" type="xml">
            <list string="Prozorro Subscriptions">
                <field name="name"/>
                <field name="user_id"/>
                <field name="team_id" optional="show"/>
                <field name="status_ids" widget="many2many_tags" optional="show"/>
                <field name="value_min" optional="hide"/>
                <field name="value_max" optional="hide"/>
                <field name="matched_count" optional="show"/>
                <field name="last_match" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="prozorro_subscription_view_form" model="ir.ui.view">
        <field name="name">prozorro.subscription.form</field>
        <field name="model">prozorro.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_sync_now" string="Sync now" type="object"
                            class="btn-primary"
                            invisible="not id"
                            groups="rteam_prozorro.group_prozorro_manager"/>
                    <button name="%(rteam_prozorro.action_prozorro_subscription_test)d"
                            string="Test against tender" type="action"
                            class="btn-secondary"
                            invisible="not id"
                            context="{'active_id': id}"/>
                    <button name="action_view_matched_tenders" string="Matched tenders" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_matched_tenders" icon="fa-flag">
                            <field string="Matches" name="matched_count" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Lasers Kyiv 100K-5M"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="create_lead"/>
                            <field name="crm_use_leads_enabled" invisible="1"/>
                            <field name="assign_to_user_id" invisible="not create_lead"/>
                            <field name="stage_id" invisible="not create_lead"/>
                            <field name="tag_ids" widget="many2many_tags" invisible="not create_lead"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not create_lead or crm_use_leads_enabled">
                        <i class="fa fa-exclamation-triangle"/>
                        <strong> Auto-create lead is disabled by CRM settings.</strong>
                        CRM Leads are turned off globally, so this subscription
                        will <strong>not</strong> create leads even though
                        "Auto-create lead" is checked. Enable Leads in
                        <em>Settings -&gt; Prozorro -&gt; CRM integration</em>
                        first.
                    </div>
                    <field name="sync_is_running" invisible="1"/>
                    <div class="alert alert-info" role="status"
                         invisible="not sync_is_running">
                        <i class="fa fa-spinner fa-spin"/>
                        <strong> Sync in progress...</strong>
                        Pull from Prozorro takes 1-30 minutes depending on the
                        feed depth. Reload the page to see new matches as they
                        come in, or check the chatter below for milestone
                        posts.
                        <button name="action_force_clear_running"
                                type="object"
                                string="Force stop"
                                class="btn btn-danger btn-sm ms-2"
                                confirm="Force-clear the 'sync running' flag? This resets the running indicator on the next refresh. Any in-flight HTTP request continues until it finishes. Continue?"
                                groups="rteam_prozorro.group_prozorro_manager"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="sync_is_running or not sync_last_error">
                        <i class="fa fa-times-circle"/>
                        <strong> Last sync failed.</strong>
                        Reload the page to clear this once the next run
                        succeeds. See chatter below for the full traceback.
                    </div>
                    <div class="alert alert-success" role="status"
                         invisible="sync_is_running or sync_last_error or not sync_last_finished_at">
                        <i class="fa fa-check-circle"/>
                        <strong> Last sync OK.</strong>
                        Pulled / matched counts and the finish timestamp are
                        on the Stats tab. Click <em>Sync now</em> to refresh.
                    </div>
                    <notebook>
                        <page string="Filters">
                            <div class="alert alert-warning" role="alert"
                                 invisible="classification_ids or keyword_ids">
                                <i class="fa fa-exclamation-triangle"/>
                                <strong> Broad filter.</strong>
                                This subscription has no CPV codes and no keywords, so it matches every tender that meets the value range / region / status / procurement-method conditions. On the open Prozorro feed that is typically thousands of tenders. Add at least one CPV (DK 021:2015 chapter, e.g. "33" for medical) or a keyword to narrow it down.
                            </div>
                            <group>
                                <group string="Region / Status / Method">
                                    <field name="region_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           placeholder="All regions"/>
                                    <field name="status_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           placeholder="All statuses"/>
                                    <field name="procurement_method_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           placeholder="All procedure types"/>
                                </group>
                                <group string="Value range">
                                    <field name="value_currency_id"/>
                                    <field name="value_min"/>
                                    <field name="value_max"/>
                                </group>
                            </group>
                            <separator string="CPV / DK021 codes"/>
                            <field name="classification_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Any CPV"/>
                            <separator string="Keywords"/>
                            <field name="keyword_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="keyword"/>
                                    <field name="field"/>
                                    <field name="match_mode"/>
                                    <field name="negate"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stats">
                            <group>
                                <group string="This subscription">
                                    <field name="matched_count" readonly="1"/>
                                    <field name="last_match" readonly="1"/>
                                </group>
                                <group string="Last global sync run">
                                    <field name="sync_last_started_at" readonly="1"/>
                                    <field name="sync_last_finished_at" readonly="1"/>
                                    <field name="sync_last_pulled" readonly="1"/>
                                    <field name="sync_last_matched" readonly="1"/>
                                    <field name="sync_last_error" readonly="1"
                                           invisible="not sync_last_error"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_prozorro_subscription" model="ir.actions.act_window">
        <field name="name">Prozorro Subscriptions</field>
        <field name="res_model">prozorro.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="prozorro_subscription_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Prozorro subscription</p>
            <p>Define which CPV codes, regions, keywords, and value ranges you care about. Matching tenders will appear in your CRM pipeline automatically.</p>
        </field>
    </record>
</odoo>
