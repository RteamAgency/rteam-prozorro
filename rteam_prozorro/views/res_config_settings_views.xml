<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_prozorro" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.prozorro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[hasclass('o_setting_box')]" position="before"/>
            <app data-string="Prozorro" string="Prozorro" name="prozorro" groups="rteam_prozorro.group_prozorro_user">
                <block title="Feed" name="prozorro_feed">
                    <setting string="API base URL" help="Public read endpoint of the Prozorro / OpenProcurement API.">
                        <field name="prozorro_api_url"/>
                    </setting>
                    <setting string="Pages per sync run" help="Each page returns up to 100 tenders.">
                        <field name="prozorro_pages_per_run"/>
                    </setting>
                    <setting string="Retention (days)" help="Drop matched tenders this many days after tender_period_end unless a CRM lead is linked.">
                        <field name="prozorro_retention_days"/>
                    </setting>
                </block>
            </app>
        </field>
    </record>

    <record id="action_prozorro_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'rteam_prozorro'}</field>
    </record>
</odoo>
