<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_prozorro" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.prozorro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Prozorro" string="Prozorro" name="rteam_prozorro" groups="rteam_prozorro.group_prozorro_user">
                    <block title="CRM integration" name="prozorro_crm_integration">
                        <setting string="Enable CRM Leads"
                                 help="Standard CRM 'Leads' toggle (same setting as Settings -> CRM -> Leads). When ON, the 'Auto-create lead' option on subscriptions actively creates Leads in the CRM Leads pool. When OFF, the Leads pool is hidden AND Prozorro will not create leads at all - subscriptions with 'Auto-create lead' checked will silently skip lead creation (warning logged). Tenders themselves are still synced and visible under Tenders.">
                            <field name="group_use_lead"/>
                            <div class="alert alert-warning mt8" role="alert" invisible="group_use_lead">
                                <i class="fa fa-exclamation-triangle"/>
                                <strong> Leads are disabled.</strong>
                                With this off, Prozorro syncs tenders normally
                                but <strong>will not create CRM leads</strong>,
                                even if a subscription has "Auto-create lead"
                                checked. Turn this on to activate lead
                                creation. (Saving the toggle adds the
                                <code>crm.group_use_lead</code> group to all
                                internal users; it is the same toggle as
                                Settings -&gt; CRM -&gt; Leads.)
                            </div>
                        </setting>
                    </block>
                    <block title="Schedule" name="prozorro_schedule">
                        <setting string="Auto-sync on schedule"
                                 help="If on, the feed sync runs automatically on the interval below. If off, sync only runs when you click 'Sync now'. Manual sync works regardless.">
                            <field name="prozorro_auto_sync_active"/>
                            <div class="content-group" invisible="not prozorro_auto_sync_active">
                                <div class="mt8">
                                    <span>Run every</span>
                                    <field name="prozorro_sync_interval_hours" class="oe_inline" style="width: 60px;"/>
                                    <span>hour(s)</span>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Status" name="prozorro_status">
                        <setting string="Sync status" help="Live status of the Prozorro feed sync.">
                            <div>
                                <div class="alert alert-info mb8" role="status" invisible="not prozorro_is_running">
                                    <i class="fa fa-spinner fa-spin"/> <strong>Sync running now</strong>
                                    <span invisible="not prozorro_last_started_at">
                                        - started <field name="prozorro_last_started_at" class="oe_inline" widget="datetime"/>
                                    </span>
                                    <button name="action_prozorro_force_clear_running"
                                            type="object"
                                            string="Force stop"
                                            class="btn btn-link btn-sm"
                                            confirm="Force-clear the 'sync running' flag? Use this only if a sync has been stuck for more than an hour. Continue?"
                                            invisible="not prozorro_can_force_clear"
                                            groups="rteam_prozorro.group_prozorro_manager"/>
                                </div>
                                <div class="alert alert-danger mb8" role="alert" invisible="not prozorro_last_error">
                                    <strong>Last error:</strong>
                                    <field name="prozorro_last_error" class="oe_inline"/>
                                </div>
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Last finished</strong></td>
                                        <td><field name="prozorro_last_sync_at"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Pulled (last run)</strong></td>
                                        <td><field name="prozorro_last_pulled"/></td>
                                    </tr>
                                    <tr>
                                        <td><strong>Matched (last run)</strong></td>
                                        <td><field name="prozorro_last_matched"/></td>
                                    </tr>
                                </table>
                                <button name="action_prozorro_sync_now" type="object"
                                        string="Sync now" class="btn btn-primary"
                                        groups="rteam_prozorro.group_prozorro_manager"/>
                                <button name="action_prozorro_reset_cursor" type="object"
                                        string="Reset cursor" class="btn btn-link"
                                        confirm="Rewind the feed cursor so the next sync pulls latest tenders. Continue?"
                                        groups="rteam_prozorro.group_prozorro_manager"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Feed" name="prozorro_feed">
                        <setting string="API base URL" help="Public read endpoint of the Prozorro / OpenProcurement API.">
                            <field name="prozorro_api_url"/>
                        </setting>
                        <setting string="Pages per sync run" help="Each page returns up to 100 tenders.">
                            <field name="prozorro_pages_per_run"/>
                        </setting>
                        <setting string="Retention (days)" help="Drop matched tenders this many days after tender_period_end unless a CRM lead is linked.">
                            <field name="prozorro_retention_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_prozorro_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'rteam_prozorro'}</field>
    </record>
</odoo>
