<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prozorro_region_view_list" model="ir.ui.view">
        <field name="name">prozorro.region.list</field>
        <field name="model">prozorro.region</field>
        <field name="arch" type="xml">
            <list string="Regions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="match_tokens"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="prozorro_region_view_form" model="ir.ui.view">
        <field name="name">prozorro.region.form</field>
        <field name="model">prozorro.region</field>
        <field name="arch" type="xml">
            <form string="Region">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                    <group>
                        <field name="match_tokens"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prozorro_region" model="ir.actions.act_window">
        <field name="name">Regions</field>
        <field name="res_model">prozorro.region</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No regions loaded yet.</p>
            <p>Ukrainian regions seeded at install. Edit match tokens or translations here.</p>
        </field>
    </record>
</odoo>
