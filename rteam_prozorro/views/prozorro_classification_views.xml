<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prozorro_classification_view_search" model="ir.ui.view">
        <field name="name">prozorro.classification.search</field>
        <field name="model">prozorro.classification</field>
        <field name="arch" type="xml">
            <search string="CPV codes">
                <field name="code"/>
                <field name="name"/>
                <field name="scheme"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group by">
                    <filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_scheme" string="Scheme" context="{'group_by': 'scheme'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="prozorro_classification_view_list" model="ir.ui.view">
        <field name="name">prozorro.classification.list</field>
        <field name="model">prozorro.classification</field>
        <field name="arch" type="xml">
            <list string="CPV codes">
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="scheme"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="prozorro_classification_view_form" model="ir.ui.view">
        <field name="name">prozorro.classification.form</field>
        <field name="model">prozorro.classification</field>
        <field name="arch" type="xml">
            <form string="CPV code">
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="scheme"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="parent_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Children">
                            <field name="child_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_prozorro_classification" model="ir.actions.act_window">
        <field name="name">CPV Codes</field>
        <field name="res_model">prozorro.classification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="prozorro_classification_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No CPV codes loaded yet.</p>
            <p>The standard DK021:2015 dictionary is loaded at install time. Manage entries here.</p>
        </field>
    </record>
</odoo>
