<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Ukrainian regions (24 oblasts + Kyiv + Crimea + Sevastopol).
        match_tokens are lowercase substrings matched against the Prozorro
        feed value `procuringEntity.address.region`. Tokens cover the most
        common spelling forms without being so loose that they cross-match
        (e.g. "івано-франківська" excludes simple "франківська" matches).
    -->

    <record id="region_vinnytsia" model="prozorro.region">
        <field name="code">vinnytsia</field>
        <field name="name">Vinnytsia oblast</field>
        <field name="match_tokens">вінницька</field>
        <field name="sequence">10</field>
    </record>

