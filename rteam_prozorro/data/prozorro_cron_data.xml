<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_prozorro_sync_feed" model="ir.cron">
        <field name="name">Prozorro: sync tender feed</field>
        <field name="model_id" ref="model_prozorro_tender"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_feed()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
    </record>

    <record id="ir_cron_prozorro_retention" model="ir.cron">
        <field name="name">Prozorro: prune stale tenders</field>
        <field name="model_id" ref="model_prozorro_tender"/>
        <field name="state">code</field>
        <field name="code">model._cron_retention()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">50</field>
    </record>
</odoo>
