<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="prozorro_subscription_test_view_form" model="ir.ui.view">
        <field name="name">prozorro.subscription.test.form</field>
        <field name="model">prozorro.subscription.test</field>
        <field name="arch" type="xml">
            <form string="Test match against tender">
                <sheet>
                    <group>
                        <field name="subscription_id"/>
                        <field name="tender_uuid"
                               placeholder="3af829c1a9af4812a5c2c4bf090f2b44 or full prozorro.gov.ua URL"/>
                    </group>
                    <group invisible="not verdict">
                        <field name="verdict" readonly="1"/>
                        <field name="fetched_title" readonly="1" invisible="not fetched_title"/>
                        <field name="fetched_status" readonly="1" invisible="not fetched_status"/>
                    </group>
                    <field name="summary_html" nolabel="1" invisible="not summary_html"/>
                </sheet>
                <footer>
                    <button name="action_test_match" type="object" string="Evaluate"
                            class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_prozorro_subscription_test" model="ir.actions.act_window">
        <field name="name">Test against tender</field>
        <field name="res_model">prozorro.subscription.test</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_prozorro_subscription"/>
        <field name="binding_view_types">form</field>
    </record>
</odoo>
