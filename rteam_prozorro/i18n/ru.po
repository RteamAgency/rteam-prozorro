msgstr "будет создавать лиды, даже если включён флаг \"Автосоздание лида\". Включите Лиды в"

#. module: rteam_prozorro
#: model_terms:ir.ui.view,arch_db:rteam_prozorro.prozorro_subscription_view_form
msgid "Settings -> Prozorro -> CRM integration"
msgstr "Настройки -> Prozorro -> Интеграция с CRM"

#. module: rteam_prozorro
#: model_terms:ir.ui.view,arch_db:rteam_prozorro.prozorro_subscription_view_form
msgid "first."
msgstr "сначала."

#. module: rteam_prozorro
#: model_terms:ir.ui.view,arch_db:rteam_prozorro.prozorro_subscription_view_form
